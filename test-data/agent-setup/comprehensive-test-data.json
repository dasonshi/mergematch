{
  "location_id": "wHb7koqaUqw8x8KoYjOj",
  "test_email_domain": "mmtest.io",
  "ghl_api_base": "https://services.leadconnectorhq.com",

  "description": "Comprehensive test dataset: 100 contacts forming 50 duplicate pairs across 5 match rule scenarios",

  "match_rules_to_create": [
    {
      "rule_id": "rule-1-exact-email",
      "name": "Exact Email Match",
      "description": "Basic exact email matching - 15 pairs should match",
      "match_config": {
        "fields": [{"field": "email", "match_type": "exact", "weight": 100}]
      },
      "merge_strategy": "standard",
      "expected_matches": 15
    },
    {
      "rule_id": "rule-2-exact-phone",
      "name": "Exact Phone Match",
      "description": "Phone number matching - 10 pairs should match",
      "match_config": {
        "fields": [{"field": "phone", "match_type": "exact", "weight": 100}]
      },
      "merge_strategy": "standard",
      "merge_settings": {
        "related_records": {
          "notes": "copy_to_master",
          "tasks": "ignore"
        }
      },
      "expected_matches": 10
    },
    {
      "rule_id": "rule-3-name-company",
      "name": "Name + Company Match",
      "description": "Fuzzy name + exact company - 10 pairs should match",
      "match_config": {
        "fields": [
          {"field": "firstName", "match_type": "fuzzy", "weight": 40},
          {"field": "lastName", "match_type": "exact", "weight": 30},
          {"field": "companyName", "match_type": "exact", "weight": 30}
        ]
      },
      "merge_strategy": "standard",
      "merge_settings": {
        "related_records": {
          "tasks": "copy_to_master"
        }
      },
      "expected_matches": 10
    },
    {
      "rule_id": "rule-4-opps-keep-all",
      "name": "Email Match - Keep All Opps",
      "description": "Email match with opportunities kept - 8 pairs with opps",
      "match_config": {
        "fields": [{"field": "email", "match_type": "exact", "weight": 100}]
      },
      "merge_strategy": "standard",
      "merge_settings": {
        "related_records": {
          "opportunities": "keep_all"
        }
      },
      "expected_matches": 8
    },
    {
      "rule_id": "rule-5-custom-logic",
      "name": "Email Match - Custom Opp Logic",
      "description": "Email match with custom opportunity filtering",
      "match_config": {
        "fields": [{"field": "email", "match_type": "exact", "weight": 100}]
      },
      "merge_strategy": "custom_logic",
      "merge_settings": {
        "related_records": {
          "notes": "copy_to_master",
          "tasks": "copy_to_master",
          "opportunities": "custom_logic",
          "opportunities_custom_logic": {
            "match_type": "all",
            "conditions": [
              {"field": "monetaryValue", "operator": ">=", "value": "1000"},
              {"field": "status", "operator": "!=", "value": "lost"}
            ]
          }
        }
      },
      "expected_matches": 7
    }
  ],

